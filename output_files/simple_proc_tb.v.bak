'timescale 1ns/1ps

module siple_proc_tb;

	reg 			clk;
	reg 			rst;
	reg [8:0] 	din;
	
	wire [15:0] bus;
	wire [15:0] R0;
	wire [15:0] R1;
	wire [15:0] R2;
	wire [15:0] R3;
	wire [15:0] R4;
	wire [15:0] R5;
	wire [15:0] R6;
	wire [15:0] R7;
	
	simple_proc DUT (
		.clk (clk)
		.rst (rst)
		.din (din)
		.bus (bus)
		.R0  (R0)
		.R1  (R1)
		.R2  (R2)
		.R3  (R3)
		.R4  (R4)
		.R5  (R5)
		.R6  (R6)
		.R7  (R7)
	);
	
	
	initial begin
		clk = 0;
		#10  clk = ~clk;
	end
	
	
	intial begin
	
		rst = 1;
		din = 9'b0;
		
		#25;
		rst = 0;
		
		// movi R0,5
		// opcode = 111
		// Rx = 000
		// imm = 101
		
		din = 9'b111000101;
		
		