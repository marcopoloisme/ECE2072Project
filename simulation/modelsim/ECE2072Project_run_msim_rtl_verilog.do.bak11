vlog -sv -work work +incdir+C:/Users/mvmya/Documents/GitHub/ECE2072Project {C:/Users/mvmya/Documents/GitHub/ECE2072Project/register_n_tb.v}

vsim -t 1ps -L altera_ver -L lpm_ver -L sgate_ver -L altera_mf_ver -L altera_lnsim_ver -L fiftyfivenm_ver -L rtl_work -L work -voptargs="+acc"  register_n_tb

