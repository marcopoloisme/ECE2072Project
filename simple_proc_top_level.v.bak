module simple_proc_top_level(SW,KEY,LEDR,HEX5);

	//define the inputs and outputs to our module
	input 	[8:0] SW;
	input 	[1:0] KEY;
	output 	[9:0] LEDR;
	output 	[6:0] HEX5;
	
	wire reset 	= ~KEY[0];
	wire clk   	= ~KEY[1];
	
	simple_proc(
	.clk (clk),
	.rst (reset),
	.din (SW),
	.bus (LEDR)
	//R0
	//R1
	//R2
	//R3
	//R4
	//R5
	//R6
	//R7
	);

	endmodule